# =============================================================================
# FluxGate — environment template.  Copy to `.env` and edit LOCALLY.
#   cp .env.example .env
# `.env` is git-ignored. NEVER commit real values. Every value below is a placeholder.
# Variable names mirror docs/TOOLS_AND_REQUIREMENTS.md §6 and docs/TRD.md §D1.
# =============================================================================

# --- Runtime profile ---------------------------------------------------------
# dev | test | prod.  `dev` allows the sanitized prompt preview (D-004); use `prod`/strict for stricter defaults.
FLUXGATE_ENV=dev
FLUXGATE_HOST=127.0.0.1
FLUXGATE_PORT=8000
FLUXGATE_LOG_LEVEL=INFO
# Optional path to the YAML config (copy config/fluxgate.example.yaml first). Env vars override YAML.
FLUXGATE_CONFIG_PATH=./config/fluxgate.yaml

# --- ZERO-COST GUARDRAILS (D-006) -------------------------------------------
# true  = router only dispatches to model aliases flagged is_free (recommended, default).
# Do NOT add payment methods to any provider account. Leave this true.
FLUXGATE_ZERO_COST_MODE=true

# --- Storage -----------------------------------------------------------------
FLUXGATE_DB_PATH=./data/fluxgate.db
FLUXGATE_AUTO_MIGRATE=true

# --- Secrets generated by YOU (never reuse these placeholders) ---------------
# Pepper for HMAC-SHA256 hashing of virtual keys. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every issued fgx- key.
FLUXGATE_KEY_PEPPER=REPLACE_ME_64_HEX_CHARS
# Protects /dashboard and /admin. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FLUXGATE_ADMIN_TOKEN=REPLACE_ME
# Admin/dashboard only reachable from loopback unless you deliberately change this.
FLUXGATE_ADMIN_BIND_LOCAL_ONLY=true

# --- Guardrails (Member 1) ---------------------------------------------------
# Named policy file in config/policies/ (default | strict)
FLUXGATE_POLICY=default
# Persist an <=80-char SANITIZED prompt preview in request logs. true in dev, false in strict/prod (D-004).
FLUXGATE_STORE_PROMPT_PREVIEW=true
FLUXGATE_CPU_THREADS=2

# --- Cache (Member 1) --------------------------------------------------------
FLUXGATE_CACHE_ENABLED=true
# Cosine similarity must be STRICTLY GREATER than this for an L2 hit. Final default set by the Phase 4 sweep.
FLUXGATE_L2_THRESHOLD=0.92
# L2 (semantic) cache only serves requests with temperature <= this; omitted temperature counts as 1.0.
FLUXGATE_L2_MAX_TEMPERATURE=0.5
FLUXGATE_CACHE_DEFAULT_TTL_S=86400
FLUXGATE_CACHE_MAX_ENTRIES_PER_TENANT=50000
FLUXGATE_EMBED_MODEL_PATH=./models/all-MiniLM-L6-v2
TIKTOKEN_CACHE_DIR=./models/tiktoken
# Keep 0 for the first run so scripts/download_models.py can fetch the model.
# Set to 1 afterwards so nothing touches the network at runtime.
HF_HUB_OFFLINE=0

# --- Router / provider resilience (Member 2) ---------------------------------
FLUXGATE_PROVIDER_PRIORITY=groq,openrouter,nvidia_nim
FLUXGATE_CB_FAILURE_THRESHOLD=5
FLUXGATE_CB_RECOVERY_S=30
FLUXGATE_CB_HALF_OPEN_PROBES=1
FLUXGATE_UPSTREAM_CONNECT_TIMEOUT_S=5
FLUXGATE_UPSTREAM_READ_TIMEOUT_S=60
# Per-provider outbound RPM/RPD caps (protect your free quota) live in config/providers.example.yaml.

# --- Provider credentials (FREE-TIER keys only; each developer uses their own) -
# Groq:        https://console.groq.com        (key format starts with the provider's prefix)
# OpenRouter:  https://openrouter.ai           (use ':free' model variants)
# NVIDIA NIM:  https://build.nvidia.com
# Leave as REPLACE_ME for any provider you have not set up; FluxGate skips providers without a key.
GROQ_API_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
NVIDIA_API_KEY=REPLACE_ME
# OpenRouter attribution headers (optional, not secrets)
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=FluxGate (local dev)
