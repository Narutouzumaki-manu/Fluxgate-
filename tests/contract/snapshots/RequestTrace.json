{
  "$defs": {
    "CacheBypassReason": {
      "enum": [
        "client_opt_out",
        "cache_disabled",
        "high_temperature",
        "tools_present",
        "multimodal",
        "n_greater_than_one",
        "pii_or_secret_present",
        "guardrail_not_clean",
        "risk_above_threshold",
        "response_not_clean",
        "incomplete_response",
        "non_stop_finish",
        "too_large",
        "cache_error",
        "tenant_quota_exceeded"
      ],
      "title": "CacheBypassReason",
      "type": "string"
    },
    "CacheOutcome": {
      "enum": [
        "hit_l1",
        "hit_l2",
        "miss",
        "bypass"
      ],
      "title": "CacheOutcome",
      "type": "string"
    },
    "Decision": {
      "enum": [
        "allow",
        "warn",
        "block"
      ],
      "title": "Decision",
      "type": "string"
    },
    "ProviderName": {
      "enum": [
        "groq",
        "openrouter",
        "nvidia_nim"
      ],
      "title": "ProviderName",
      "type": "string"
    },
    "StageTimings": {
      "additionalProperties": false,
      "properties": {
        "auth_ms": {
          "default": 0,
          "title": "Auth Ms",
          "type": "number"
        },
        "guardrails_in_ms": {
          "default": 0,
          "title": "Guardrails In Ms",
          "type": "number"
        },
        "guardrails_out_ms": {
          "default": 0,
          "title": "Guardrails Out Ms",
          "type": "number"
        },
        "l1_ms": {
          "default": 0,
          "title": "L1 Ms",
          "type": "number"
        },
        "l2_ms": {
          "default": 0,
          "title": "L2 Ms",
          "type": "number"
        },
        "parse_ms": {
          "default": 0,
          "title": "Parse Ms",
          "type": "number"
        },
        "ratelimit_ms": {
          "default": 0,
          "title": "Ratelimit Ms",
          "type": "number"
        },
        "router_overhead_ms": {
          "default": 0,
          "title": "Router Overhead Ms",
          "type": "number"
        },
        "total_ms": {
          "default": 0,
          "title": "Total Ms",
          "type": "number"
        },
        "ttft_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttft Ms"
        },
        "upstream_ms": {
          "default": 0,
          "title": "Upstream Ms",
          "type": "number"
        }
      },
      "title": "StageTimings",
      "type": "object"
    }
  },
