{
  "$defs": {
    "CacheBypassReason": {
      "enum": [
        "client_opt_out",
        "cache_disabled",
        "high_temperature",
        "tools_present",
        "multimodal",
        "n_greater_than_one",
        "pii_or_secret_present",
        "guardrail_not_clean",
        "risk_above_threshold",
        "response_not_clean",
        "incomplete_response",
        "non_stop_finish",
        "too_large",
        "cache_error",
        "tenant_quota_exceeded"
      ],
      "title": "CacheBypassReason",
      "type": "string"
    },
    "CacheKeys": {
      "additionalProperties": false,
      "description": "Computed at L1 lookup and passed through to maybe_store to avoid recomputation.",
      "properties": {
        "cache_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Scope"
        },
        "compat_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compat Hash"
        },
        "exact_key": {
          "title": "Exact Key",
          "type": "string"
        }
      },
      "required": [
        "exact_key"
      ],
      "title": "CacheKeys",
      "type": "object"
    },
    "CacheOutcome": {
      "enum": [
        "hit_l1",
        "hit_l2",
        "miss",
        "bypass"
      ],
      "title": "CacheOutcome",
      "type": "string"
    },
    "ChatCompletionChoice": {
      "additionalProperties": true,
      "properties": {
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "index": {
          "default": 0,
          "title": "Index",
          "type": "integer"
        },
        "message": {
          "$ref": "#/$defs/ChatMessage"
        }
      },
      "required": [
        "message"
      ],
      "title": "ChatCompletionChoice",
      "type": "object"
    },
    "ChatCompletionResponse": {
      "additionalProperties": true,
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/ChatCompletionChoice"
          },
          "title": "Choices",
          "type": "array"
        },
        "created": {
          "title": "Created",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "object": {
          "const": "chat.completion",
          "default": "chat.completion",
          "title": "Object",
          "type": "string"
        },
        "system_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Fingerprint"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatCompletionUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "created",
        "model",
        "choices"
      ],
      "title": "ChatCompletionResponse",
      "type": "object"
    },
    "ChatCompletionUsage": {
      "additionalProperties": true,
      "properties": {
        "completion_tokens": {
          "default": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "prompt_tokens": {
          "default": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "ChatCompletionUsage",
      "type": "object"
    },
    "ChatMessage": {
      "additionalProperties": true,
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "required": [
        "role"
      ],
      "title": "ChatMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "age_seconds": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Age Seconds"
    },
    "bypass_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/CacheBypassReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "compat_mismatch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compat Mismatch"
    },
    "embed_ms": {
      "default": 0.0,
      "title": "Embed Ms",
      "type": "number"
    },
    "entry_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry Id"
    },
    "keys": {
      "anyOf": [
        {
          "$ref": "#/$defs/CacheKeys"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latency_ms": {
      "default": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "near_miss_similarity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Near Miss Similarity"
    },
    "outcome": {
      "$ref": "#/$defs/CacheOutcome"
    },
    "response": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatCompletionResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "search_ms": {
      "default": 0.0,
      "title": "Search Ms",
      "type": "number"
    },
    "similarity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Similarity"
    },
    "ttl_remaining_seconds": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ttl Remaining Seconds"
    }
  },
  "required": [
    "outcome"
  ],
  "title": "CacheResult",
  "type": "object"
}
